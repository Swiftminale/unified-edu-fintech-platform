# Caddyfile configuration for Unified Edu-Fintech Platform (UEFP)
# Reverse Proxy mapping to expose both frontend & backend services under a unified origin

http://localhost:80 {
    # Reverse proxy API endpoints to the NestJS backend on port 3001
    handle_path /api/* {
        reverse_proxy localhost:3001
    }

    # Reverse proxy all web portal pages and assets to the Next.js frontend on port 3000
    handle {
        reverse_proxy localhost:3000
    }
}
